# Exemple d'environnement de test live-prudent (B8 acté).
# Copier vers .env.test (JAMAIS commité, gitignoré) et remplir.
# Déclenchement : SERGE_LIVE_TESTS=1 + Julien présent. Jamais en CI/pre-commit.
SERGE_ENV=test
SERGE_LIVE_TESTS=1
# Allowlist owner-only : les tests live n'envoient QU'ici (refus dét sinon).
SERGE_TEST_EMAILS=owner1@example.com,owner2@example.com
SERGE_TEST_SMS=+33600000000
SERGE_TEST_DISCORD_CHANNEL=serge-tests
SERGE_TEST_DISCORD_CHANNEL_ID=
# Smoke Discord (tests/test_live_discord.py) : bot ajouté au serveur test.
SERGE_TEST_DISCORD_BOT_TOKEN=
# Séquence E (canary 1 € test-mode + refund, tests/test_live_collect.py) :
# SERGE_STRIPE_TEST_KEY=sk_test_...
# Clés live réutilisées (mêmes sidecars que la prod, lecture seule en test) :
# OPENROUTER_API_KEY / Android gateway : voir policy.test.yaml
# et docs/LEGACY_REUSE (gog) — injectées par l'environnement, jamais en dur.
