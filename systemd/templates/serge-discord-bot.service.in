[Unit]
Description=Serge Discord bot (tickets mirror + owner acts)
After=network.target
ConditionPathExists=__SYSTEM_ROOT__/serge/discord/cli.py

[Service]
Type=simple
WorkingDirectory=__SYSTEM_ROOT__
Environment=HOME=__HOME__
Environment=USER=__USER__
Environment=PYTHONUNBUFFERED=1
Environment=SERGE_INSTANCE_FILE=__INSTANCE_FILE__
Environment=SERGE_HOME=__HOME__
Environment=SERGE_SYSTEM_ROOT=__SYSTEM_ROOT__
Environment=SERGE_MANDATE_PATH=__POLICY__
Environment=SERGE_POLICY_PATH=__POLICY__
ExecStart=__PYTHON__ __SYSTEM_ROOT__/serge/discord/cli.py serve
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
