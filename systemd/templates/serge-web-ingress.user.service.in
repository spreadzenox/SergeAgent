[Unit]
Description=Serge generic multi-venture web ingress (Caddy)
After=network.target
ConditionPathExists=__SYSTEM_ROOT__/state/web-ingress/Caddyfile

[Service]
Type=simple
WorkingDirectory=__SYSTEM_ROOT__
Environment=HOME=__HOME__
Environment=USER=__USER__
Environment=SERGE_INSTANCE_FILE=__INSTANCE_FILE__
Environment=SERGE_HOME=__HOME__
Environment=SERGE_SYSTEM_ROOT=__SYSTEM_ROOT__
Environment=SERGE_MANDATE_PATH=__POLICY__
Environment=SERGE_POLICY_PATH=__POLICY__
Environment=SERGE_INGRESS_LISTEN=__INGRESS_LISTEN__
ExecStartPre=__PYTHON__ __SYSTEM_ROOT__/orchestrator/web_ingress.py render
ExecStart=__CADDY__ run --config __SYSTEM_ROOT__/state/web-ingress/Caddyfile --adapter caddyfile
ExecReload=__CADDY__ reload --config __SYSTEM_ROOT__/state/web-ingress/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
