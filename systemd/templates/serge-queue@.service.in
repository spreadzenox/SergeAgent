[Unit]
Description=Serge : la file de tâches %i (une tâche après l'autre)
After=network.target

[Service]
Type=simple
WorkingDirectory=__SYSTEM_ROOT__
Environment=HOME=__HOME__
Environment=USER=__USER__
Environment=LOGNAME=__USER__
Environment=PYTHONUNBUFFERED=1
Environment=SERGE_AGENT_RUNTIME=__AGENT_RUNTIME__
Environment=SERGE_INSTANCE_FILE=__INSTANCE_FILE__
Environment=SERGE_HOME=__HOME__
Environment=SERGE_SYSTEM_ROOT=__SYSTEM_ROOT__
Environment=SERGE_MANDATE_PATH=__POLICY__
Environment=SERGE_POLICY_PATH=__POLICY__
Environment=XDG_RUNTIME_DIR=/run/user/__UID__
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/__UID__/bus
__GMAIL_UNIT_LINES__ExecStart=__PYTHON__ __SYSTEM_ROOT__/scripts/serge-queue.py --queue %i
Restart=always
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__SYSTEM_ROOT__/queue __SYSTEM_ROOT__/evidence __SYSTEM_ROOT__/logs __SYSTEM_ROOT__/state __SYSTEM_ROOT__/orchestrator/runtime __SYSTEM_ROOT__/projects __CONFIG_ROOT__ __HOME__/.local/share /tmp
LockPersonality=yes

[Install]
WantedBy=default.target
