[Unit]
Description=Serge public mission-control dashboard
After=network.target
ConditionPathExists=__SYSTEM_ROOT__/orchestrator/public_dashboard.py

[Service]
Type=simple
WorkingDirectory=__SYSTEM_ROOT__
Environment=HOME=__HOME__
Environment=USER=__USER__
Environment=PYTHONUNBUFFERED=1
Environment=SERGE_INSTANCE_FILE=__INSTANCE_FILE__
Environment=SERGE_HOME=__HOME__
Environment=SERGE_SYSTEM_ROOT=__SYSTEM_ROOT__
Environment=SERGE_MANDATE_PATH=__POLICY__
Environment=SERGE_POLICY_PATH=__POLICY__
Environment=SERGE_PUBLIC_DASHBOARD_HOST=127.0.0.1
Environment=SERGE_PUBLIC_DASHBOARD_PORT=8790
ExecStart=__PYTHON__ __SYSTEM_ROOT__/orchestrator/public_dashboard.py --host 127.0.0.1 --port 8790
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
