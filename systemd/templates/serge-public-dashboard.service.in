[Unit]
Description=Serge Mission Control HTTP service (public & owner)
After=network.target
ConditionPathExists=__SYSTEM_ROOT__/serge/mc/server.py

[Service]
Type=simple
WorkingDirectory=__SYSTEM_ROOT__
Environment=HOME=__HOME__
Environment=USER=__USER__
Environment=PYTHONUNBUFFERED=1
Environment=SERGE_INSTANCE_FILE=__INSTANCE_FILE__
Environment=SERGE_HOME=__HOME__
Environment=SERGE_SYSTEM_ROOT=__SYSTEM_ROOT__
Environment=SERGE_MANDATE_PATH=__POLICY__
Environment=SERGE_POLICY_PATH=__POLICY__
Environment=SERGE_MC_HOST=127.0.0.1
Environment=SERGE_MC_PORT=8790
ExecStart=__PYTHON__ -m serge.mc.server --host 127.0.0.1 --port 8790
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
